# Suna Deployment Configuration Template
# 复制此文件为 config.env 并填写您的配置
# cp config.env.example config.env

#===============================================================================
# 域名配置
#===============================================================================
# 主域名 (例如: suna.example.com)
DOMAIN_NAME=

# API 域名 (留空则使用 api.$DOMAIN_NAME)
API_DOMAIN=

# SSL 证书邮箱 (用于 Let's Encrypt)
SSL_EMAIL=

#===============================================================================
# Supabase 配置 (必填)
# 从 Supabase Dashboard -> Settings -> API 获取
#===============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

#===============================================================================
# LLM API 配置 (至少填写一个)
#===============================================================================
# Anthropic Claude API Key
ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI API Key
OPENAI_API_KEY=sk-xxxxx

# 其他 LLM (可选)
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

#===============================================================================
# 搜索服务配置 (必填)
#===============================================================================
# Tavily 搜索 API (https://tavily.com)
TAVILY_API_KEY=tvly-xxxxx

# Firecrawl 网页抓取 (https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-xxxxx

# RapidAPI Key (https://rapidapi.com)
RAPID_API_KEY=xxxxx

#===============================================================================
# Daytona 沙箱配置 (必填)
# Agent 执行环境 (https://www.daytona.io)
#===============================================================================
DAYTONA_API_KEY=your-daytona-key
DAYTONA_TARGET=us

#===============================================================================
# 安全配置
# 如果不填写，部署脚本会自动生成
#===============================================================================
# Fernet 加密密钥 (用于加密敏感凭据)
MCP_CREDENTIAL_ENCRYPTION_KEY=

# 管理 API 密钥
KORTIX_ADMIN_API_KEY=

#===============================================================================
# 监控配置 (可选但推荐)
#===============================================================================
# Sentry 错误追踪 (https://sentry.io)
SENTRY_DSN=

# Langfuse LLM 追踪 (https://langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

#===============================================================================
# 部署选项
#===============================================================================
# 是否配置 SSL (Y/n)
SETUP_SSL=Y
